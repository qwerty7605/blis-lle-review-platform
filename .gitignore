*.log
.DS_Store
# Deny every env file by default, then allow only the committed templates.
# Enumerating individual names (.env.backup, .env.production, ...) means any
# new one -- .env.staging, .env.local -- is tracked by accident.
.env*
!.env.example
!.env.docker.example
.phpactor.json
.phpunit.result.cache
/.claude
/.fleet
/.idea
/.nova
/.phpunit.cache
/.vscode
/.zed
/auth.json
/node_modules
/public/build
/public/hot
/public/storage
/storage/*.key
/storage/pail
/storage/db-backups
/vendor
Homestead.json
Homestead.yaml
Thumbs.db
tmp/

# Playwright MCP screenshots, logs and capture scripts
.playwright-mcp/

# Output of ml/tools/compare_with_weka.php and of compiling the Java tools
ml/tools/compare/
ml/tools/**/*.class

# The live-site edition of the test cases prints the website test accounts and
# their passwords, so neither it nor the file they are read from is kept here.
/docs/testing/BLIS-Test-Cases-Live-Site.pdf
/docs/testing/source/live-accounts.json
/docs/testing/source/*.html

# WEKA is downloaded separately (ml/README.md, "Getting WEKA"); it is GPL-licensed and not part of this repo.
/ml/tools/weka-stable.jar

# The Relevant Source Code appendix is built by docs/relevant-source-code/build.mjs and kept with the paper, not here.
/docs/relevant-source-code/*.docx
