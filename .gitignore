*.log
.DS_Store
# Deny every env file by default, then allow only the committed templates.
# Enumerating individual names (.env.backup, .env.production, ...) means any
# new one -- .env.staging, .env.local -- is tracked by accident.
.env*
!.env.example
!.env.docker.example
.phpactor.json
.phpunit.result.cache
/.claude
/.fleet
/.idea
/.nova
/.phpunit.cache
/.vscode
/.zed
/auth.json
/node_modules
/public/build
/public/hot
/public/storage
/storage/*.key
/storage/pail
/storage/db-backups
/vendor
Homestead.json
Homestead.yaml
Thumbs.db
tmp/

# Playwright MCP screenshots, logs and capture scripts
.playwright-mcp/
