# Credentials for the MySQL container (docker-compose.yml -> db.env_file).
# Copy this to .env.docker and fill in real values:
#
#     cp .env.docker.example .env.docker
#
# MYSQL_PASSWORD must match DB_PASSWORD in .env -- that is the account the
# Laravel app connects as. MYSQL_ROOT_PASSWORD is separate and nothing in the
# app uses it; keep the two different.
#
# IMPORTANT: these values are only applied when the mysql_data volume is first
# created. Editing them later does NOT change an existing database user -- for
# that you have to ALTER USER inside the running container.
MYSQL_DATABASE=lnu_lle
MYSQL_USER=lnu
MYSQL_PASSWORD=replace-with-a-long-random-string
MYSQL_ROOT_PASSWORD=replace-with-a-different-long-random-string
