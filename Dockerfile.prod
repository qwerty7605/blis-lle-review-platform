# Production image. The development `dockerfile` bind-mounts the repo and
# expects vendor/ to arrive from the host; this one is self-contained, so what
# gets tested is what gets deployed.

# ---------------------------------------------------------------- SPA build
# Node exists only in this stage. The runtime images never need it, which keeps
# a whole toolchain out of production.
FROM node:22-alpine AS frontend

WORKDIR /build
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build

# ------------------------------------------------------------ PHP base image
# Shared by the dependency stage and the runtime so the extension set is built
# exactly once and both stages agree on it.
#
# The -dev headers are deliberately left in place. Purging them with
# --auto-remove also takes the runtime shared libraries gd and intl link
# against, and the resulting image fails at request time rather than build
# time -- a worse trade than the ~60MB saved.
FROM php:8.2-fpm AS base

RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        libzip-dev libpng-dev libjpeg62-turbo-dev libfreetype6-dev \
        libonig-dev libicu-dev \
    ; \
    docker-php-ext-configure gd --with-freetype --with-jpeg; \
    docker-php-ext-install -j"$(nproc)" \
        pdo_mysql mbstring zip intl bcmath gd opcache \
    ; \
    rm -rf /var/lib/apt/lists/*

# ------------------------------------------------------------ PHP packages
# Runs on `base` rather than the official composer image: phpspreadsheet and
# phpword both require ext-gd, which that image does not carry, so installing
# there would need --ignore-platform-reqs and could resolve a package set the
# real runtime cannot support.
FROM base AS vendor

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer
ENV COMPOSER_ALLOW_SUPERUSER=1

WORKDIR /build
COPY composer.json composer.lock ./
# --no-scripts because artisan is not here yet; the autoloader is generated
# after the source lands, below.
RUN composer install --no-dev --no-scripts --no-autoloader --prefer-dist --no-interaction
COPY . .
RUN composer dump-autoload --optimize --classmap-authoritative --no-dev

# ------------------------------------------------------- runtime: PHP-FPM
FROM base AS app

COPY docker/php/production.ini /usr/local/etc/php/conf.d/zz-production.ini
COPY docker/php/www.conf /usr/local/etc/php-fpm.d/zz-www.conf

WORKDIR /var/www

COPY --from=vendor --chown=www-data:www-data /build /var/www
# The built SPA lands beside index.php so a single nginx root serves both:
# static files and the history-mode fallback from here, /api through PHP.
COPY --from=frontend --chown=www-data:www-data /build/dist /var/www/public

COPY --chown=www-data:www-data docker/entrypoint.sh /usr/local/bin/entrypoint
RUN chmod +x /usr/local/bin/entrypoint \
 && mkdir -p storage/framework/cache storage/framework/sessions storage/framework/views storage/logs bootstrap/cache \
 && chown -R www-data:www-data storage bootstrap/cache

USER www-data

ENTRYPOINT ["entrypoint"]
CMD ["php-fpm"]

# --------------------------------------------------------- runtime: nginx
# nginx serves static files itself and only proxies PHP, so it needs its own
# copy of public/. Building it as a second target from the same stages keeps
# the two images in lockstep -- a shared volume would drift, because a named
# volume is populated once and then ignores later image builds.
FROM nginx:1.29-alpine AS web

COPY nginx/production.conf /etc/nginx/conf.d/default.conf
# Laravel's public/ first (index.php, favicon, robots.txt), then the built SPA
# on top (index.html, assets/). They do not collide.
COPY --from=vendor /build/public /var/www/public
COPY --from=frontend /build/dist /var/www/public
